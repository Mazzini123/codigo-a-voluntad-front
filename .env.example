VITE_API_URL=http://localhost:8000
# Base usada por Axios. En desarrollo usa /api y el proxy de Vite.
# En producción sin reverse proxy, indicar la URL pública del backend.
VITE_API_BASE_URL=/api

# Logto (ver README → "Ingreso con Logto"). Si VITE_LOGTO_ENDPOINT queda vacío,
# la app arranca sin sesión y sin Logto, para trabajar en las pantallas públicas.
VITE_LOGTO_ENDPOINT=
VITE_LOGTO_APP_ID=
VITE_LOGTO_API_RESOURCE=https://api.codigo-a-voluntad

# Opcional: logto | simulada. Vacío = se elige según las variables de abajo.
VITE_AUTH_PROVIDER=

# Solo para `npm run dev`: sesión simulada sin Logto ni back.
# COLECTIVO, COLABORADORA o SIN_PERFIL. Vacía = apagada. En el build se ignora.
VITE_SESION_SIMULADA=
# Id de un colectivo o colaboradora real del back que usa la sesión simulada como su perfil.
VITE_SESION_SIMULADA_PERFIL_ID=
