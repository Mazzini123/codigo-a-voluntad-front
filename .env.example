VITE_API_URL=http://localhost:8000
# Base usada por Axios. En desarrollo usa /api y el proxy de Vite.
# En producción sin reverse proxy, indicar la URL pública del backend.
VITE_API_BASE_URL=/api

# Eleccion de proveedor de autenticacion
# Soportados por ahora:
# logto
VITE_AUTH_PROVIDER=logto

# Integracion con Logto
VITE_LOGTO_ENDPOINT=https://xxxx.logto.app/
VITE_LOGTO_APP_ID=xxxxxxx